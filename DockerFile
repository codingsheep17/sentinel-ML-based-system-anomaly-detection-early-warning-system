# 1. Use official lightweight Python 3.12 image
FROM python:3.12-slim

# 2. Set environment variables to prevent Python from buffering outputs
ENV PYTHONUNBUFFERED=1

# 3. Create app working directory
WORKDIR /app

# 4. Copy and install dependencies first (caches Docker layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of the application code
COPY . .

# 6. Hugging Face Spaces Docker defaults to port 7860 (Streamlit defaults to 8501)
EXPOSE 7860

# 7. Start Streamlit bound to 0.0.0.0 and port 7860
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=7860", "--server.address=0.0.0.0"]